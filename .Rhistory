#library(lubridate)
library(ggplot2)
library(dplyr)
library(stringr)
library(lubridate)
AllCSVFileName="./Log_Energie.csv"
AllEnergie <- read.csv(AllCSVFileName, header = TRUE,      # première ligne = noms de colonnes
sep = ",",          # séparateur ("," par défaut)
stringsAsFactors = FALSE,
colClasses = "character") # toutes les valeurs sont des caractères
AllEnergie$TimeStamp <-dmy_hm(paste(AllEnergie$Date, AllEnergie$Heure))
AllEnergie$Index = as.numeric(AllEnergie$Index)
ConsoAnnuelle <- function(Test){
TestM1 <- lag(Test,1)
TestM1 <- tail(TestM1,nrow(TestM1)-1)
Test <- tail(Test,nrow(Test)-1)
Test$DeltaConso <- Test$Index - TestM1$Index
Test$DeltaTS <- difftime(Test$TimeStamp, TestM1$TimeStamp, units = "days")
Test <- Test %>% mutate(Journalier = DeltaConso*365.25/as.numeric(DeltaTS))
Test <- Test %>% arrange(TimeStamp) %>%
# on trouve l'index un an plus tôt
mutate(timestamp_cible = TimeStamp %m-% years(1), idx = findInterval(timestamp_cible, TimeStamp) -1)
# get Y moins 1
Test2 <- Test %>% filter (idx > 0 )
Test2$YM1 <- Test[Test2$idx,"TimeStamp"]
Test2$IndexYM1 <- Test[Test2$idx,"Index"]
Test2 <- Test2 %>% mutate ( DeltaT = as.numeric(TimeStamp-YM1) ) %>%
mutate (Annuel =( Index- IndexYM1)*365/DeltaT)
# Journalier = consommation courante amenée à 365 jours
# Annuel = Delta Index à Year moins 1
OutPut <- Test2 %>% select(c(TimeStamp,Energie,Journalier,Annuel))
return(OutPut)
}
#
Eau <- AllEnergie %>% filter (Energie %in% c("Eau"))
ConsoEau <- tail ( ConsoAnnuelle(Eau), 24)
ConsoPrévue <- int (tail(ConsoEau$Annuel,1) )
